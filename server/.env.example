NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# If your password contains @ : / ? # or %, write it URL-encoded (e.g. @ becomes %40), in both URLs below.
DATABASE_URL=postgresql://kitchensync:postgres@localhost:5432/kitchensync?schema=public
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Google Gemini API key (https://aistudio.google.com). Required for photo scans; optional for the assistant.
# Without it, assistant answers use offline mode and only the sample scan buttons work.
AI_API_KEY=
AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-2.5-flash
AI_FALLBACK_MODEL=gemini-flash-lite-latest
AI_SEARCH_MODEL=gemini-3.8-flash
AI_VISION_MODEL=gemini-2.5-flash

# Separate database used by `npm test` (tests write data to it). Must contain "test" in its name.
TEST_DATABASE_URL=postgresql://kitchensync:postgres@localhost:5432/kitchensync_test?schema=public

# ---- Staging / production (see RELEASE-READINESS.md) ----
# Behind an HTTPS reverse proxy or load balancer, trust it so secure cookies work: e.g. 1 (one hop).
# TRUST_PROXY=1
# Serve the built web app from the API (single origin, recommended for staging).
# SERVE_CLIENT=true
# CLIENT_DIST_DIR=../client/dist
# Secure cookies default to on in production. Only set false for local HTTP testing of a production build.
# COOKIE_SECURE=false
# JSON request logs; defaults to on in production.
# LOG_REQUESTS=true
# Rate limits (in-memory, per server instance).
# RATE_LIMIT_LOGIN=10        # attempts per IP + email per 15 minutes (and password changes per user)
# RATE_LIMIT_LOGIN_IP=50     # attempts per IP across all emails per 15 minutes
# RATE_LIMIT_REGISTER=20     # sign-ups per IP per hour
# RATE_LIMIT_JOIN=10         # invite-code attempts per user per 15 minutes
# RATE_LIMIT_ASSISTANT=10    # assistant messages per user per minute
# RATE_LIMIT_ASSISTANT_DEMO=20 # assistant messages per hour shared by all demo kitchens on one IP
# Google sign-in: the team's OAuth Web client ID (public, not a secret). Leave as is, set your own, or "off" to hide the button.
GOOGLE_CLIENT_ID=1070549791591-q7m3po6rhvhu4n3r3vvpee1drd4lpci6.apps.googleusercontent.com
