generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HouseholdRole {
  OWNER
  MEMBER
}

enum StockConfidence {
  CONFIRMED
  ESTIMATED
  CHECK_NEEDED
}

enum StockSource {
  MANUAL
  PURCHASE
  RECIPE_DEDUCTION
  CORRECTION
  IMPORT
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
}

enum MealStatus {
  PLANNED
  COOKING
  COMPLETED
  CANCELLED
}

enum StockTransactionType {
  INITIAL_STOCK
  PURCHASE_RECEIVED
  COOKING_CONSUMPTION
  CORRECTION
  MANUAL_USE
  REMOVED
}

enum ShoppingItemStatus {
  NEEDED
  PURCHASED
  RECEIVED
}

enum Allergen {
  MILK
  EGG
  PEANUT
  TREE_NUT
  GLUTEN
  SOY
  SESAME
  FISH
  SHELLFISH
  MUSTARD
}

/// What an ingredient is, for working out a recipe's diet type.
enum DietClass {
  PLANT
  DAIRY
  EGG
  MEAT
  SEAFOOD
}

/// What a person eats. Recipes don't store one: it is derived from their ingredients.
enum DietType {
  VEGAN
  VEGETARIAN
  EGGETARIAN
  NON_VEGETARIAN
}

/// AVOID is a restriction and blocks recipes; LIKE only influences ranking.
enum IngredientPrefKind {
  AVOID
  LIKE
}

enum RecipePrefKind {
  FAVOURITE
  DISLIKE
}

enum AgeGroup {
  CHILD
  TEEN
  ADULT
  SENIOR
}

/// Everyday kitchen jobs, separate from the OWNER/MEMBER permission role.
enum KitchenRole {
  PLANNER
  COOK
  SHOPPER
  STOCK_CHECKER
}

enum Appliance {
  GAS_STOVE
  INDUCTION
  MICROWAVE
  AIR_FRYER
  OVEN
  PRESSURE_COOKER
  MIXER_GRINDER
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

/// express-session storage used by connect-pg-simple. Declared here so migrations own it.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)
  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

model User {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String
  /// Google's stable account id ("sub") once the user signs in with Google.
  googleSub    String?           @unique
  /// False for accounts created through Google until they choose a password.
  hasPassword  Boolean           @default(true)
  /// Set only for "See a demo kitchen" accounts; the account and its household are deleted after this time.
  demoExpiresAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  memberships  HouseholdMember[]
  transactions StockTransaction[]
  cookingEvents CookingEvent[]
  verifications InventoryVerification[]
  foodProfile   UserFoodProfile?
  ingredientPrefs UserIngredientPref[]
  recipePrefs   UserRecipePref[]
  eatenLogs     EatenLog[]
  absences      MealAbsence[]
  snoozes       RecommendationSnooze[]
}

model Household {
  id               String            @id @default(cuid())
  name             String
  defaultServings  Int               @default(3)
  /// IANA zone used to decide what "today" is for meal planning and the dashboard.
  timezone         String            @default("Asia/Kolkata")
  /// Share this code so others can join the household. Null when invites are switched off.
  inviteCode       String?           @unique
  /// How many people usually eat at home, from onboarding.
  peopleCount      Int?
  /// Cooking equipment in this kitchen.
  appliances       Appliance[]       @default([])
  /// Minutes the household usually has for cooking a meal; longer recipes rank lower in suggestions.
  usualCookMinutes Int?
  /// Null until the owner finishes the onboarding cards; households created before onboarding count as done.
  onboardingCompletedAt DateTime?
  familyProfiles   FamilyProfile[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  members          HouseholdMember[]
  ingredients      Ingredient[]
  pantryItems      PantryItem[]
  recipes          Recipe[]
  mealPlans        MealPlan[]
  stockTransactions StockTransaction[]
  shoppingLists    ShoppingList[]
  verifications    InventoryVerification[]
  notifications    Notification[]
  foodProfile      HouseholdFoodProfile?
  eatenLogs        EatenLog[]
  snoozes          RecommendationSnooze[]
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  userId      String
  role        HouseholdRole @default(MEMBER)
  /// Kitchen jobs this person usually does (plan, cook, shop, check stock). Only changes what they see first.
  kitchenRoles KitchenRole[]  @default([])
  joinedAt    DateTime      @default(now())
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([householdId, userId])
  @@index([userId])
}

/// Global catalog entries have householdId = null; custom entries belong to one household.
/// nameKey is the trimmed, lower-cased name used for duplicate detection.
model Ingredient {
  id             String               @id @default(cuid())
  householdId    String?
  name           String
  nameKey        String
  category       String               @default("Other")
  /// One of g, ml, count. Pantry and recipe quantities are stored in this unit.
  canonicalUnit  String
  /// Null means not yet classified, so recipes using it have an unknown diet type.
  dietClass      DietClass?
  allergens      Allergen[]           @default([])
  /// False until someone has checked the allergens. An empty list is only "no allergens" once reviewed.
  allergensReviewed Boolean           @default(false)
  household      Household?           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  pantryItems    PantryItem[]
  recipeLines    RecipeIngredient[]
  allocations    MealIngredientAllocation[]
  shoppingItems  ShoppingListItem[]
  stockTransactions StockTransaction[]
  userPrefs      UserIngredientPref[]
  @@unique([householdId, nameKey])
  @@index([nameKey])
}

model PantryItem {
  id                String          @id @default(cuid())
  householdId       String
  ingredientId      String
  quantity          Decimal         @db.Decimal(12, 3)
  unit              String
  lowStockThreshold Decimal?        @db.Decimal(12, 3)
  confidence        StockConfidence @default(ESTIMATED)
  source            StockSource     @default(MANUAL)
  purchasedAt       DateTime?
  expiresAt         DateTime?
  lastVerifiedAt    DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  household         Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredient        Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  transactions      StockTransaction[]
  verifications     InventoryVerification[]
  @@unique([householdId, ingredientId])
  @@index([householdId, confidence])
}

model Recipe {
  id           String             @id @default(cuid())
  householdId  String?
  name         String
  description  String             @default("")
  category     String             @default("Other")
  /// Ingredient quantities are written for this many servings and scaled from it.
  baseServings Int                @default(4)
  prepMinutes  Int                @default(30)
  cookMinutes  Int                @default(0)
  instructions String[]
  isShared     Boolean            @default(false)
  cuisine      String             @default("")
  /// 1 (mild) to 5 (very hot); null when not set.
  spiceLevel   Int?
  tags         String[]           @default([])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  household    Household?         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredients  RecipeIngredient[]
  plannedMeals PlannedMeal[]
  userPrefs    UserRecipePref[]
  eatenLogs    EatenLog[]
  snoozes      RecommendationSnooze[]
  @@index([householdId, name])
}

/// One person's food needs. Allergies and the diet type are hard rules; the rest only guides ranking.
model UserFoodProfile {
  id        String     @id @default(cuid())
  userId    String     @unique
  dietType  DietType?
  allergens Allergen[] @default([])
  /// Highest spice level the person enjoys, 1-5.
  maxSpice  Int?
  cuisines  String[]   @default([])
  ageGroup  AgeGroup?
  /// Soft goals such as LOW_OIL or HIGH_PROTEIN; they guide suggestions, never block a dish.
  healthGoals String[] @default([])
  /// Days of the week this person fasts, e.g. a Monday fast.
  weeklyFasts Weekday[] @default([])
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Someone who eats at home but has no KitchenSync login, such as a child or grandparent.
/// Their diet and allergies count for the whole household exactly like a member's.
model FamilyProfile {
  id          String     @id @default(cuid())
  householdId String
  name        String
  ageGroup    AgeGroup?
  dietType    DietType?
  allergens   Allergen[] @default([])
  healthGoals String[]   @default([])
  weeklyFasts Weekday[]  @default([])
  kitchenRoles KitchenRole[] @default([])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  household   Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  @@index([householdId])
}

model UserIngredientPref {
  id           String             @id @default(cuid())
  userId       String
  ingredientId String
  kind         IngredientPrefKind
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient   Ingredient         @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  @@unique([userId, ingredientId])
}

model UserRecipePref {
  id       String         @id @default(cuid())
  userId   String
  recipeId String
  kind     RecipePrefKind
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe   Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  @@unique([userId, recipeId])
}

/// Household-wide defaults, set by the owner.
model HouseholdFoodProfile {
  id          String    @id @default(cuid())
  householdId String    @unique
  cuisines    String[]  @default([])
  usualSpice  Int?
  updatedAt   DateTime  @updatedAt
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  ingredientId String
  /// Total for the recipe's baseServings, in the ingredient's canonical unit.
  quantity     Decimal    @db.Decimal(12, 3)
  unit         String
  note         String     @default("")
  position     Int        @default(0)
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  @@unique([recipeId, ingredientId])
}

model MealPlan {
  id          String        @id @default(cuid())
  householdId String
  weekStart   DateTime      @db.Date
  createdAt   DateTime      @default(now())
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  meals       PlannedMeal[]
  @@unique([householdId, weekStart])
}

model PlannedMeal {
  id          String                    @id @default(cuid())
  mealPlanId  String
  recipeId    String
  date        DateTime                  @db.Date
  slot        MealSlot
  servings    Int
  status      MealStatus                @default(PLANNED)
  cookingStartedAt DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  mealPlan    MealPlan                  @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe      Recipe                    @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  allocations MealIngredientAllocation[]
  cookingEvent CookingEvent?
  absences    MealAbsence[]
  @@unique([mealPlanId, date, slot])
  @@index([date, status])
}

/// A meal eaten without being cooked through KitchenSync (before using the app, or not marked cooked).
/// History only: it never touches stock.
model EatenLog {
  id          String        @id @default(cuid())
  householdId String
  recipeId    String
  date        DateTime      @db.Date
  slot        MealSlot
  loggedById  String
  createdAt   DateTime      @default(now())
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipe      Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  loggedBy    User          @relation(fields: [loggedById], references: [id], onDelete: Cascade)
  absences    MealAbsence[]
  @@unique([householdId, date, slot])
}

/// A member who did not eat a planned meal or logged meal. Everyone else in the household counts as having eaten it.
/// Exactly one of plannedMealId and eatenLogId is set (enforced by a CHECK constraint in the migration).
model MealAbsence {
  id            String       @id @default(cuid())
  userId        String
  plannedMealId String?
  eatenLogId    String?
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedMeal   PlannedMeal? @relation(fields: [plannedMealId], references: [id], onDelete: Cascade)
  eatenLog      EatenLog?    @relation(fields: [eatenLogId], references: [id], onDelete: Cascade)
  @@unique([plannedMealId, userId])
  @@unique([eatenLogId, userId])
}

/// "Not today": hides a recipe from the household's suggestions until `until`.
model RecommendationSnooze {
  id          String    @id @default(cuid())
  householdId String
  recipeId    String
  snoozedById String
  until       DateTime
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipe      Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  snoozedBy   User      @relation(fields: [snoozedById], references: [id], onDelete: Cascade)
  @@unique([householdId, recipeId])
}

model MealIngredientAllocation {
  id            String       @id @default(cuid())
  plannedMealId String
  ingredientId  String
  quantity      Decimal      @db.Decimal(12, 3)
  unit          String
  plannedMeal   PlannedMeal  @relation(fields: [plannedMealId], references: [id], onDelete: Cascade)
  ingredient    Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  @@unique([plannedMealId, ingredientId])
  @@index([ingredientId])
}

/// One per completed meal. The unique plannedMealId is what guarantees a meal deducts stock only once.
model CookingEvent {
  id             String      @id @default(cuid())
  plannedMealId  String      @unique
  idempotencyKey String      @unique
  actorUserId    String
  note           String      @default("")
  completedAt    DateTime    @default(now())
  plannedMeal    PlannedMeal @relation(fields: [plannedMealId], references: [id], onDelete: Restrict)
  actor          User        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  transactions   StockTransaction[]
}

model StockTransaction {
  id             String                @id @default(cuid())
  idempotencyKey String                @unique
  householdId    String
  /// Null once the pantry item is deleted; ingredientId keeps the history readable.
  pantryItemId   String?
  ingredientId   String
  actorUserId    String
  cookingEventId String?
  type           StockTransactionType
  delta          Decimal               @db.Decimal(12, 3)
  balanceAfter   Decimal               @db.Decimal(12, 3)
  unit           String
  note           String                @default("")
  createdAt      DateTime              @default(now())
  household      Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  pantryItem     PantryItem?           @relation(fields: [pantryItemId], references: [id], onDelete: SetNull)
  ingredient     Ingredient            @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  actor          User                  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  cookingEvent   CookingEvent?         @relation(fields: [cookingEventId], references: [id], onDelete: SetNull)
  @@index([householdId, createdAt])
  @@index([pantryItemId, createdAt])
}

model ShoppingList {
  id          String             @id @default(cuid())
  householdId String
  name        String             @default("Weekly shopping")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  household   Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items       ShoppingListItem[]
  @@unique([householdId, name])
}

model ShoppingListItem {
  id             String             @id @default(cuid())
  shoppingListId String
  ingredientId   String?
  name           String
  quantity       Decimal            @db.Decimal(12, 3)
  unit           String             @default("item")
  status         ShoppingItemStatus @default(NEEDED)
  /// MANUAL, SHORTAGE or ASSISTANT: how the item got onto the list.
  source         String             @default("MANUAL")
  note           String             @default("")
  receivedQty    Decimal?           @db.Decimal(12, 3)
  purchasedAt    DateTime?
  receivedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  shoppingList   ShoppingList       @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  ingredient     Ingredient?        @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  @@index([shoppingListId, status])
}

model InventoryVerification {
  id          String      @id @default(cuid())
  householdId String
  pantryItemId String?
  actorUserId String
  oldQuantity Decimal     @db.Decimal(12, 3)
  newQuantity Decimal     @db.Decimal(12, 3)
  unit        String
  note        String      @default("")
  verifiedAt  DateTime    @default(now())
  household   Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  pantryItem  PantryItem? @relation(fields: [pantryItemId], references: [id], onDelete: SetNull)
  actor       User        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  @@index([householdId, verifiedAt])
}

model Notification {
  id          String    @id @default(cuid())
  householdId String
  title       String
  body        String
  /// In-app path the notification points to, e.g. /planner?week=2026-11-02
  link        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  @@index([householdId, readAt, createdAt])
}
